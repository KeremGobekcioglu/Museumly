<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark parent and a black window background: the system splash and the
        window take their colour from this theme before Compose draws anything.
        With a light theme they paint near-white, and the jump to the black
        gallery reads as a flash on every launch.
    -->
    <style name="Theme.Museumly" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!--
        Launch theme for MainActivity. installSplashScreen() swaps it for
        postSplashScreenTheme before the first frame. The icon is the launcher
        foreground until the lamp artwork exists.
    -->
    <style name="Theme.Museumly.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Museumly</item>
    </style>
</resources>