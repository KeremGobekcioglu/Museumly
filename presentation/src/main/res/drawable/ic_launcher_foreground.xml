<?xml version="1.0" encoding="utf-8"?>
<!-- Source: museumlyIcons/museumly_lamp_frame.svg, minus its black backdrop (that is ic_launcher_background). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Frame -->
    <path
        android:fillColor="#6B5F45"
        android:fillType="evenOdd"
        android:pathData="M376,420 H648 V786 H376 Z M412,456 H612 V750 H412 Z" />
    <path
        android:fillType="evenOdd"
        android:pathData="M376,420 H648 V786 H376 Z M412,456 H612 V750 H412 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="512"
                android:startY="420"
                android:endX="512"
                android:endY="786">
                <item android:color="#FFC9B282" android:offset="0.0" />
                <item android:color="#59C9B282" android:offset="0.3" />
                <item android:color="#00C9B282" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Light cone -->
    <path android:pathData="M394,342 L630,342 L648,420 L648,786 L376,786 L376,420 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="512"
                android:startY="342"
                android:endX="512"
                android:endY="756">
                <item android:color="#5CF3D9A6" android:offset="0.0" />
                <item android:color="#24F3D9A6" android:offset="0.38" />
                <item android:color="#00F3D9A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cord -->
    <path
        android:pathData="M512,120 L512,228"
        android:strokeColor="#8C877E"
        android:strokeWidth="12" />

    <!-- Bulb -->
    <path
        android:fillColor="#FFF1D2"
        android:pathData="M476,342 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0 Z" />

    <!-- Shade -->
    <path
        android:fillColor="#1C1B19"
        android:pathData="M466,228 L558,228 L630,342 L394,342 Z"
        android:strokeColor="#8C877E"
        android:strokeLineJoin="round"
        android:strokeWidth="10" />

    <!-- Rim light -->
    <path
        android:pathData="M394,342 L630,342"
        android:strokeColor="#FFF1D2"
        android:strokeLineCap="round"
        android:strokeWidth="14" />
</vector>